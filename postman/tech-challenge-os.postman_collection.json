        {
          "name": "Acompanhar com token de cliente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlation_id}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/os/ordens-servico/acompanhar/{{numero_os}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "os",
                "ordens-servico",
                "acompanhar",
                "{{numero_os}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_cliente}}",
                  "type": "string"
                }
              ]
            },
            "description": "Localmente não há Lambda: o pré-request assina um JWT no formato dela (role Cliente, claim cliente_id) com jwt_key. Em ambiente com a Lambda, use o token que ela devolve."
          },
          "response": [],
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const cripto = require('crypto-js');",
                  "const b64 = (palavras) => cripto.enc.Base64.stringify(palavras).replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
                  "const json = (obj) => b64(cripto.enc.Utf8.parse(JSON.stringify(obj)));",
                  "const agora = Math.floor(Date.now() / 1000);",
                  "const corpo = {",
                  "  cliente_id: pm.collectionVariables.get('cliente_id_lambda'),",
                  "  role: 'Cliente',",
                  "  iss: pm.environment.get('jwt_issuer'),",
                  "  aud: pm.environment.get('jwt_audience'),",
                  "  iat: agora,",
                  "  exp: agora + 600",
                  "};",
                  "const assinatura = json({ alg: 'HS256', typ: 'JWT' }) + '.' + json(corpo);",
                  "const hmac = b64(cripto.HmacSHA256(assinatura, pm.environment.get('jwt_key')));",
                  "pm.collectionVariables.set('token_cliente', assinatura + '.' + hmac);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('devolve a OS do cliente', () => pm.expect(pm.response.json().numero).to.eql(pm.collectionVariables.get('numero_os')));"
                ]
              }
            }
          ]
        }
      ]
