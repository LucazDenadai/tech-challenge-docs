{
  "info": {
    "name": "Tech Challenge — Serviço OS (Fase 4)",
    "description": "Rotas do serviço OS (CARD-37b): autenticação, cadastros, abertura e consulta da OS, endpoint interno da Lambda, acompanhamento pelo cliente e transições manuais, com casos de falha. Cada request envia um X-Correlation-Id novo e confere que a resposta o devolve. Ver postman/README.md em tech-challenge-docs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set('correlation_id', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('devolve o X-Correlation-Id enviado', () => {",
          "  pm.expect(pm.response.headers.get('X-Correlation-Id')).to.eql(pm.collectionVariables.get('correlation_id'));",
          "});"
        ]
      }
    }
  ],
  "item": [
